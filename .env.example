NEXT_PUBLIC_PRIMARY_API=https://streamed.pk/api/matches/football
NEXT_PUBLIC_BACKUP_API=https://api.cdnlivetv.tv/api/v1/events/sports/?user=cdnlivetv&plan=free
NEXT_PUBLIC_PRIMARY_STREAM=https://streamed.pk/api/stream

# Required in Vercel Production. Generate a unique random value.
STREAM_SECRET=replace-with-a-long-random-secret

# Optional distributed cache. Without these values, the app uses in-memory caching.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Ads & Monetization toggle (defaults to true if omitted)
NEXT_PUBLIC_ENABLE_ADS=true

# Optional custom WatchFooty-compatible API base.
# NEXT_PUBLIC_API_BASE=https://api.watchfooty.st
